    "license": "MIT",
    "authors": [
        {
            "name": "yuandian",
            "email": "467490186@qq.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "monolog/monolog": "^2.8",
        "ext-mbstring": "*",
        "workerman/webman-framework": "^2.2",
        "workerman/http-client": "^3.0",
        "yuandian/container": "^1.0",
        "yuandian/tools": "^1.0",
        "webman/channel": "^2.1"
